{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-dna/patch.schema.json",
  "title": "Design DNA typed patch (one transaction)",
  "type": "object",
  "required": ["schema_version", "base_revision", "ops"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "base_revision": {"type": "integer", "minimum": 0},
    "intent": {"type": "string", "description": "the user's words this patch was compiled from"},
    "keep": {"enum": ["everything_else"], "description": "freeze every property path not requested or declared as a dependency"},
    "relax": {"type": "array", "items": {"type": "string"}, "description": "ids of relaxable constraints this request may break"},
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["set", "replace", "move", "resize", "remove", "add", "lock", "unlock", "adapt", "reflow"]}
        },
        "allOf": [
          {"if": {"properties": {"op": {"const": "set"}}}, "then": {"required": ["path", "value"]}},
          {"if": {"properties": {"op": {"const": "replace"}}}, "then": {"required": ["node", "file"], "properties": {"preserve": {"type": "array", "items": {"enum": ["treatment", "crop-intent", "anchor", "mask", "effects"]}}, "baked_effects": {"type": "array", "items": {"type": "string"}}}}},
          {"if": {"properties": {"op": {"const": "move"}}}, "then": {"required": ["node", "dx", "dy"]}},
          {"if": {"properties": {"op": {"const": "resize"}}}, "then": {"required": ["node", "w", "h"], "properties": {"anchor": {"enum": ["top-left", "center", "top-right", "bottom-left", "bottom-right"]}}}},
          {"if": {"properties": {"op": {"const": "remove"}}}, "then": {"required": ["node"]}},
          {"if": {"properties": {"op": {"const": "add"}}}, "then": {"required": ["node_def"]}},
          {"if": {"properties": {"op": {"const": "lock"}}}, "then": {"required": ["target"]}},
          {"if": {"properties": {"op": {"const": "unlock"}}}, "then": {"required": ["target"]}},
          {"if": {"properties": {"op": {"const": "adapt"}}}, "then": {"required": ["language", "contents"]}},
          {"if": {"properties": {"op": {"const": "reflow"}}}, "then": {"required": ["canvas"]}}
        ]
      }
    }
  }
}
