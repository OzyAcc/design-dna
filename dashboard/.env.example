# Design DNA dashboard settings. Copy to dashboard/.env (docker compose) or export them before
# `python -m dna_dashboard all`. Every value is optional unless marked required.

# Workspace access token. Required whenever the app listens on a non-local address (always in the container).
DNA_AUTH_TOKEN=change-me-to-a-long-random-string

# Provider keys. Without them, intake, manual scanning, editing and editable adaptation still work;
# AI-assisted analysis/copy drafts (Claude) and creative image generation (OpenAI GPT Image) are disabled.
# Keys can also be entered on the Settings page (stored in <data>/secrets.json, mode 0600).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models (defaults shown).
DNA_ANALYSIS_MODEL=claude-opus-5-5
DNA_COPY_MODEL=claude-opus-5-5
DNA_IMAGE_MODEL=gpt-image-2

# Where templates, versions, outputs and the SQLite database live (outside the container: ~/design-dna-dashboard).
# DNA_DATA_DIR=/data

# Network (outside the container the default is 127.0.0.1:8765).
# DNA_HOST=127.0.0.1
# DNA_PORT=8765
# DNA_PUBLISH_PORT=8765        # docker compose: host port for the web app

# Fonts: extra folders searched for template fonts (os.pathsep-separated). Uploaded fonts go to <data>/fonts.
# DNA_FONT_DIRS=
# DNA_USE_VENDORED_FONTS=1     # the repository's OFL/Bitstream Vera test fonts

# Limits.
# DNA_MAX_UPLOAD_MB=25
# DNA_MAX_MEGAPIXELS=40
# DNA_FETCH_TIMEOUT=12
# DNA_FETCH_MAX_MB=15
# DNA_FETCH_PROXY=             # route link fetches through an HTTP(S) proxy
# DNA_WORKER_THREADS=2
# DNA_LEASE_SECONDS=180

# Tests only. Never enable in a real workspace: mock providers return labelled, fake results.
# DNA_ENABLE_MOCK_PROVIDERS=0
# DNA_FETCH_ALLOW_PRIVATE=0
